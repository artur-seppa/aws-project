# Banco (lido pelo docker-compose e pela API)
# DB_PORT = porta no SEU host. 5432 costuma estar ocupada por outros projetos.
POSTGRES_USER=produtos
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=produtos
DB_PORT=5434

# API rodando fora do Docker (npm run start:dev)
DB_HOST=localhost
PORT=3333

# Portas publicadas pelo docker compose
API_PORT=3333
WEB_PORT=3000
CORS_ORIGIN=http://localhost:3000

# Imagens no S3 (Fase 4). Sem S3_BUCKET o upload fica desabilitado.
S3_BUCKET=
AWS_REGION=us-east-1
# Só para rodar na sua máquina. Na EC2 use uma IAM role e deixe isto vazio.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
