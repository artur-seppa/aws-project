# Banco (lido pelo docker-compose e pela API)
# DB_PORT = porta no SEU host. 5432 costuma estar ocupada por outros projetos.
POSTGRES_USER=produtos
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=produtos
DB_PORT=5434

# API rodando fora do Docker (npm run start:dev)
DB_HOST=localhost
PORT=3333

# Portas publicadas pelo docker compose
API_PORT=3333
WEB_PORT=3000
CORS_ORIGIN=http://localhost:3000
